<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

  <bean id="mcpAuth" class="com.example.teamcity.mcp.McpTokenAuth"/>

  <bean id="mcpTeamCityServer" class="com.example.teamcity.mcp.McpTeamCityServer">
    <constructor-arg ref="buildServer"/>
    <constructor-arg ref="webControllerManager"/>
    <constructor-arg ref="mcpAuth"/>
  </bean>
</beans>
